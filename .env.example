# PostgreSQL connection string for the application and Prisma migrations.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/freshfold?schema=public"

# Generate a unique value with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-secret"

# First administrator provisioned by `npm run db:seed`.
ADMIN_NAME="FreshFold Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-unique-password-of-at-least-10-characters"
